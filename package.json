{
  "name": "atims",
  "version": "0.1.0",
  "private": true,
  "description": "Agro-Trace Integrated Management System — monorepo root",
  "workspaces": [
    "frontend",
    "api",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=api\" \"npm run dev --workspace=frontend\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=api",
    "test": "npm run test --workspace=api"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
